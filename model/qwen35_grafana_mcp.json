{
  "mcpServers": {
    "grafana": {
      "command": "docker",
      "args": [
        "run",
        "--rm",
        "-i",
        "--env",
        "GRAFANA_URL",
        "--env",
        "GRAFANA_SERVICE_ACCOUNT_TOKEN",
        "grafana/mcp-grafana@sha256:2ed63c4d9d67557c8ea6cc6988743ddd9008e248bd9842e760fec378a0b61062",
        "-t",
        "stdio",
        "--usage-stats=disabled",
        "--disable-write",
        "--disable-api",
        "--enabled-tools",
        "search,dashboard,datasource,prometheus,loki,tempo,navigation"
      ],
      "timeout_ms": 60000
    }
  }
}
